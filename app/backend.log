[0mSQL Prompt: [{'role': 'system', 'content': 'You are a SQL expert. Please help to generate a SQL query to answer the question. Your response should ONLY be based on the given context and follow the response guidelines and format instructions. \n===Tables \nCREATE OR REPLACE FORCE VIEW "ITPS_LZ_DEV"."V_JCWB_DAYPLAN" ("DAYPLANID", "DSPID", "PLAN_CODE", "PLAN_DATE", "DEPT_ID", "DEPT_NAME", "SECLINE_ID", "SECLINE_NAME", "RAIL_TYPE", "PLAN_TYPE", "PLAN_TYPE_NAME", "START_TIME", "END_TIME", "WORK_MINUTES", "COMPLETE_FLAG", "FLOW_NODE_STATUS", "REPLY_STATUS", "TRAIN_LIMIT", "REGIST_STATION", "TRAIN_INFOR", "SKYLIGHT_TYPE_NAME", "OVERHAUL_TYPE", "OVERHAUL_TYPE_NAME", "WORK_LEADER", "DIRECTION_NAME", "IS_CANCEL", "REMARK", "WEEKFLAG", "WORK_PROJECT", "WORK_ADDRESS", "WORK_MILEAGE", "BLOCK_MILEAGE", "WORK_CONTENT_INFLUENCE", "BUSINESS_OFFICES", "WORK_DEPT_AND_LEADER", "WORK_LEVEL", "FLOW_TRACK", "COORDINATE_DEPT", "JOINTLY_SIGN", "WORK_LEADER_TEL") AS \n  SELECT\n    t.DAYPLANID, -- 日计划主键id\n    sp.DSPID, -- 天窗计划id\n    t.PLAN_CODE, -- 计划号\n    t.PLAN_DATE, -- 计划日期\n    t.DEPT_ID,  -- 部门id\n    d.DEPT_NAME,  -- 部门名称\n    nvl(t.SECLINE_ID,jjdjs.SECLINE_IDS) AS SECLINE_ID,  -- 线路id,多条线路逗号分割\n    nvl(sl.SECLINE_NAME,jjdjs.SECLINE_NAMES) AS SECLINE_NAME,  -- 线路名称,多条线路逗号分割\n    nvl(sl.SECLINE_TYPE,jjdjs.RAIL_TYPES) AS RAIL_TYPE,  -- 线路类型,多条线路对应类型逗号分割\n    t.PLAN_TYPE,  -- 计划类型  1-检修 2-施工,3-天窗计划,4-点外计划,5-巡视计划\n    DECODE(t.PLAN_TYPE,1,\'检修\',2,\'施工\',3,\'天窗计划\',4,\'点外计划\',5,\'巡视计划\',null) AS PLAN_TYPE_NAME, -- 计划类型名称\n    t.START_TIME,  -- 计划开始时间\n    t.END_TIME,  -- 计划结束时间\n    t.WORK_MINUTES,  -- 计划作业分钟数\n    NVL2(jdsp.DAY_PLAN_ID,\n         CASE\n             WHEN jdsp.START_TIME IS NOT NULL AND jdsp.END_TIME IS NOT NULL AND jdsp.START_TIME >= SYSDATE AND jdsp.END_TIME < SYSDATE  THEN 1\n             WHEN jdsp.STEP_NAME_LIST IS NOT NULL AND INSTR(jdsp.STEP_NAME_LIST, \'进栅前材料清点\') IS NOT NULL AND INSTR(jdsp.STEP_NAME_LIST, \'入库清点\') IS NOT NULL THEN 1\n             WHEN jdsp.STEP_NAME_LIST IS NOT NULL AND INSTR(jdsp.STEP_NAME_LIST, \'进栅前材料清点\') IS NOT NULL AND INSTR(jdsp.STEP_NAME_LIST, \'入库清点\') IS NULL THEN 2\n             WHEN jdsp.STEP_NAME_LIST IS NULL AND jdsp.START_TIME IS NOT NULL AND (jdsp.END_TIME IS NULL OR jdsp.END_TIME < SYSDATE) THEN 2\n             ELSE 0 END\n        ,NVL(t.COMPLETE_FLAG, 0)) AS COMPLETE_FLAG,  -- 完成状态0-未开始，1-已完成,2-进行中\n    t.FLOW_NODE_STATUS,  -- 计划流程节点状态：-1-所有已完成，0-计划导入,-2-碰头会，1-签发工作票，2-审核工作票，3-方案编制,8-预分工会，4-分工会，5-收工会，6-台账记录，7-台账审核\n    t.REPLY_STATUS,  -- 批复状态 0：未批复 1：已通过\n    sp.TRAIN_LIMIT,  -- 行车限制卡\n    sp.REGIST_STATION,  -- 登记站\n    sp.TRAIN_INFOR,  -- 路用列车信息\n    st.SKYLIGHT_TYPE_NAME, -- 天窗类型名称\n    sp.PLAN_TYPE AS OVERHAUL_TYPE,  -- 天窗计划类型 1-检修 2-施工,3-天窗计划,4-点外计划,5-巡视计划\n    DECODE(sp.PLAN_TYPE,1,\'检修\',2,\'施工\',3,\'天窗计划\',4,\'点外计划\',5,\'巡视计划\',null) AS OVERHAUL_TYPE_NAME, -- 天窗计划类型名称\n    NVL(jcr.WORK_LEADER,NVL(t.WORK_LEADER, ss.STAFF_NAME)) AS WORK_LEADER, -- 负责人\n    sp.PLAN_UPDOWN AS direction_name,  -- 行别名称\n    t.ISCANCEL AS IS_CANCEL, -- 是否取消\n    t.REMARK,  -- 备注\n    to_char(t.PLAN_DATE, \'iw\') AS weekFlag,  -- 计划时间是当年第几周\n    jcr.WORK_PROJECT, -- 施工项目\n    jcr.WORK_ADDRESS, -- 地点\n    jcr.WORK_MILEAGE, -- 施工里程\n    jcr.BLOCK_MILEAGE  -- 封锁里程\n    , jcr.WORK_CONTENT_INFLUENCE, -- 施工内容及影响范围\n    jcr.BUSINESS_OFFICES, -- 审核流程\n    jcr.WORK_DEPT_AND_LEADER,  -- 施工单位及负责人\n    jcr.WORK_LEVEL, -- 等级\n    jcr.FLOW_TRACK,  -- 流程跟踪\n    jcr.COORDINATE_DEPT, -- 配合单位\n    jcr.JOINTLY_SIGN, -- 会签\n    jcr.WORK_LEADER_TEL  -- 负责人电话\nFROM\n    JCWB_DAYPLAN t\n        LEFT JOIN JCWB_DAY_SKYLIGHT_PLAN sp ON sp.DAYPLANID = t.DAYPLANID\n        LEFT JOIN JCWB_SKYLIGHT JS ON JS.DSPID = SP.DSPID\n        LEFT JOIN JCWB_SKYLIGHT_TYPE st ON st.SKYLIGHT_TYPE_ID = sp.SKYLIGHT_TYPE_ID\n        LEFT JOIN SYS_DEPT d ON d.DEPT_ID = t.DEPT_ID\n        LEFT JOIN JC_SECLINE sl ON sl.SECLINE_ID = t.SECLINE_ID\n        LEFT JOIN SYS_STAFF ss ON ss.STAFF_ID = t.WORK_LEADER_ID\n        LEFT JOIN (\n        SELECT p.DSPID, p.WORK_PROJECT, p.WORK_ADDRESS, p.WORK_MILEAGE, p.BLOCK_MILEAGE\n             , p.WORK_CONTENT_INFLUENCE, p.BUSINESS_OFFICES, p.WORK_DEPT_AND_LEADER, p.WORK_LEVEL, p.FLOW_TRACK\n             , p.COORDINATE_DEPT, p.JOINTLY_SIGN, p.WORK_LEADER, p.WORK_LEADER_TEL\n        FROM JCWB_DAY_CONSTRUCTION_PLAN p\n        UNION ALL\n        SELECT p.DSPID, p.WORK_PROJECT, p.WORK_ADDRESS, p.WORK_MILEAGE, p.BLOCK_MILEAGE\n             , p.WORK_CONTENT_INFLUENCE, p.BUSINESS_OFFICES, p.WORK_DEPT_AND_LEADER, p.WORK_LEVEL, p.FLOW_TRACK\n             , p.COORDINATE_DEPT, p.JOINTLY_SIGN, p.WORK_LEADER, p.WORK_LEADER_TEL\n        FROM JCWB_DAY_REPAIR_PLAN p\n    ) jcr ON jcr.DSPID =sp.DSPID\n        LEFT JOIN (\n        SELECT DISTINCT p.DAYPLANID AS DAY_PLAN_ID, p.workticket_id AS workticket_id, dp.START_TIME, dp.END_TIME, l.JOB_DEVIDE_LIST_ID\n                      , LISTAGG(o.operate_step_name, \',\') WITHIN GROUP ( ORDER BY p.DAYPLANID) AS STEP_NAME_LIST\n        FROM JCWB_DAYPLAN dp\n            INNER JOIN JCWB_DAY_SKYLIGHT_PLAN sp ON sp.DAYPLANID = dp.DAYPLANID\n            LEFT JOIN JCWB_DAYPLAN_JOIN_WORKTICKET p ON dp.DAYPLANID = p.DAYPLANID\n            LEFT JOIN JCWB_JOB_DEVIDE_LIST l ON l.WORKTICKET_ID = p.WORKTICKET_ID\n            LEFT JOIN JCW_GROUP_OPERATE_MAIN m ON m.JOB_DEVIDE_LIST_ID = l.JOB_DEVIDE_LIST_ID\n            LEFT JOIN JCW_GROUP_OPERATE o ON m.GROUP_OPERATE_MAIN_ID = o.GROUP_OPERATE_MAIN_ID\n        WHERE p.DAYPLANID IS NOT NULL\n        GROUP BY p.DAYPLANID, p.workticket_id, dp.START_TIME, dp.END_TIME, l.JOB_DEVIDE_LIST_ID\n    ) jdsp ON jdsp.DAY_PLAN_ID = t.DAYPLANID\n        LEFT JOIN(\n        SELECT jdjs.DAYPLANID,\n               LISTAGG(sl.SECLINE_ID, \', \') WITHIN GROUP (ORDER BY sl.SECLINE_ID) AS SECLINE_IDS,\n LISTAGG(sl.SECLINE_NAME, \', \') WITHIN GROUP (ORDER BY sl.SECLINE_NAME) AS SECLINE_NAMES,\n            LISTAGG(sl.RAIL_TYPE, \', \') WITHIN GROUP (ORDER BY sl.SECLINE_NAME) AS RAIL_TYPES\n        FROM (\n            SELECT\n            DISTINCT jdjs1.DAYPLANID ,jdjs1.SECLINE_ID\n            FROM JCWB_DAYPLAN_JOIN_SECLINE jdjs1\n            ) jdjs\n            LEFT JOIN JC_SECLINE sl ON sl.SECLINE_ID = jdjs.SECLINE_ID\n        GROUP BY jdjs.DAYPLANID\n    ) jjdjs ON jjdjs.DAYPLANID=t.DAYPLANID\nWHERE (t.DEL_FLAG = \'N\' OR t.DEL_FLAG IS NULL);\n\n\n    CREATE OR REPLACE FORCE VIEW "ITPS_LZ_DEV"."V_JCJC_DEFECT_INFO" ("ID", "C_TYPE", "LINE_ID", "LINE_NAME", "DIRECTION_ID", "DIRECTION_NAME", "SITE_ID", "SITE_NAME", "TUNNEL_ID", "TUNNEL_NAME", "TRACK_ID", "TRACK_NAME", "PILLAR_ID", "PILLAR_NUM", "ROAD_MARK", "DEPT_ID", "DEPT_NAME", "DEFECT_EQUIPMENT_ID", "DEFECT_EQUIPMENT_NAME", "DEFECT_EQUIPMENT_CODE", "DEFECT_COMPONENT_ID", "DEFECT_COMPONENT_NAME", "DEFECT_COMPONENT_CODE", "DEFECT_BIG_CATEGORY_ID", "DEFECT_BIG_CATEGORY_NAME", "DEFECT_BIG_CATEGORY_CODE", "DEFECT_CATEGORY_ID", "DEFECT_CATEGORY_NAME", "DEFECT_CATEGORY_CODE", "DEFECT_LEVEL_ID", "DEFECT_LEVEL_NAME", "DEFECT_LEVEL_CODE", "DEFECT_CODE", "DEFECT_DESCRIPTION", "DEFECT_ADDITIONAL_DESCRIPTION", "DETECT_DATE", "DETECT_JOB_ID", "FIND_PERSON_ID", "FIND_PERSON", "FIND_DEPT_ID", "FIND_DEPT_NAME", "FIND_DATE", "CONFIRM_PERSONAL_ID", "CONFIRM_PERSONAL", "CONFIRM_DATE", "SOLVE_PERSONAL_ID", "SOLVE_PERSONAL", "SOLVE_DATE", "SOLVE_DESC", "SOLVE_FILL_PERSONAL_ID", "SOLVE_FILL_PERSONAL", "SOLVE_FILL_DATE", "LATEST_SOLVE_DATE", "STATUS", "SIX_STATUS", "CREATE_BY", "UPDATE_BY", "CREATE_DATETIME", "UPDATE_DATETIME", "TASK_ID", "ANALYSE_PILLAR_ID", "RAW_PICTURE_PATH", "MARK_INFO", "IS_PAST", "REPEAT_ID", "SOLVE_COMPLETE_TIME", "DEFECT_TYPE_ID", "DEFECT_REASON_ID", "DISCOVER_SOURCE_TYPE_ID", "SOURCE_TYPE_NAME", "DISCOVER_SOURCE_ID", "SOLVE_SOURCE_TYPE_ID", "SOLVE_SOURCE_ID", "REMARK", "SYSTEM_SOURCE", "PILLAR_DEPT_ID", "DEFECT_POSITION_ID", "SOLVE_WORKAREA_ID", "HANDLE_WORKAREA_ID", "RECTIF_TIME", "RECTIF_TIME_UNIT", "DEVICE_CLASS_ID", "INPUT_AUDIT_STATUS", "RECTIF_AUDIT_STATUS", "CHECK_AUDIT_STATUS", "RECTIFICATION_SUGGESTIONS", "DEFERRED_STATUS", "DEFECT_STATUS", "PROCESS_SOURCE", "CREATE_DEPT_NO", "SOURCE_MODEL", "CREATE_DATETIME_SOURCE", "RETURN_STATUS", "OLD_ID", "OLD_DEPTNAME", "OLD_SITENAME", "PLAN_ID", "JOB_ID", "SHOW_NAME", "MEMO", "UNIT_DEPT_CODE", "RAIL_TYPE", "DEFECT_VALUE", "MAIN_ID", "DEFECT_FILE_FULL_PATH", "SOLVE_FILE_FULL_PATH") AS \n  SELECT\n\tt.ID, -- 主键id\n\tt.C_TYPE, -- 6C装置类型\n\tt.LINE_ID, -- 线路id\n\tt.LINE_NAME, -- 线路中文名\n\tt.DIRECTION_ID, -- 行别id\n\tt.DIRECTION_NAME, -- 行别中文名\n\tt.SITE_ID, -- 区站id\n\tt.SITE_NAME, --区站中文名\n\tt.TUNNEL_ID, -- 隧道ID\n\tt.TUNNEL_NAME,-- 隧道名称\n\tt.TRACK_ID, -- 股道ID\n\tt.TRACK_NAME, -- 股道名称\n\tt.PILLAR_ID, --支柱id\n\tt.PILLAR_NUM,  -- 支柱号\n\tt.ROAD_MARK,   -- 公里标\n\tt.DEPT_ID,  -- 部门id\n\tt.DEPT_NAME,  -- 部门名称\n\tt.DEFECT_EQUIPMENT_ID, -- 接触网器材ID\n\tt.DEFECT_EQUIPMENT_NAME, -- 接触网器材名称\n\tt.DEFECT_EQUIPMENT_CODE, --接触网器材编码\n\tt.DEFECT_COMPONENT_ID, -- 接触网零部件ID\n\tt.DEFECT_COMPONENT_NAME,  -- 接触网零部件名称\n\tt.DEFECT_COMPONENT_CODE,  -- 接触网零部件编码\n\tt.DEFECT_BIG_CATEGORY_ID,  -- 缺陷名称大类ID\n\tt.DEFECT_BIG_CATEGORY_NAME,  -- 缺陷名称大类\n\tt.DEFECT_BIG_CATEGORY_CODE,  -- 缺陷名称大类编码\n\tt.DEFECT_CATEGORY_ID, -- 缺陷名称ID\n\tt.DEFECT_CATEGORY_NAME, -- 缺陷名称\n\tt.DEFECT_CATEGORY_CODE,  -- 缺陷名称编码\n\tt.DEFECT_LEVEL_ID, -- 缺陷等级ID\n\tt.DEFECT_LEVEL_NAME, -- 缺陷等级名称\n\tt.DEFECT_LEVEL_CODE,  -- 缺陷等级编码\n\tt.DEFECT_CODE,  -- 缺陷编码\n\tt.DEFECT_DESCRIPTION, -- 缺陷描述\n\tt.DEFECT_ADDITIONAL_DESCRIPTION,  -- 缺陷补充描述\n\tt.DETECT_DATE,  -- 车辆检测日期，不是缺陷出现的日期\n\tt.DETECT_JOB_ID, -- 检测作业ID\n\tt.FIND_PERSON_ID,  -- 发现人id\n\tt.FIND_PERSON,  -- 发现人名称\n\tt.FIND_DEPT_ID, -- 发现部门id\n\tt.FIND_DEPT_NAME, -- 发现部门名称\n\tt.FIND_DATE, -- 发现日期，缺陷出现的时间\n\tt.CONFIRM_PERSONAL_ID, -- 缺陷确认人id\n\tt.CONFIRM_PERSONAL, -- 缺陷确认人名称\n\tt.CONFIRM_DATE, -- 缺陷确认时间\n\tt.SOLVE_PERSONAL_ID,  -- 消缺人IDid\n\tt.SOLVE_PERSONAL, -- 消缺人名称\n\tt.SOLVE_DATE,  -- 消缺日期\n\tt.SOLVE_DESC,   -- 整改措施\n\tt.SOLVE_FILL_PERSONAL_ID, -- 消缺填报人ID\n\tt.SOLVE_FILL_PERSONAL, -- 消缺填报人名称\n\tt.SOLVE_FILL_DATE,  -- 消缺填报时间\n\tt.LATEST_SOLVE_DATE,  -- 整改期限\n\tt.STATUS,  -- 缺陷状态\n\tt.SIX_STATUS, -- 6C缺陷状态\n\tt.CREATE_BY, \n\tt.UPDATE_BY,\n\tt.CREATE_DATETIME,\n\tt.UPDATE_DATETIME,\n\tt.TASK_ID,  -- 任务ID\n\tt.ANALYSE_PILLAR_ID,  -- 分析支柱ID\n\tt.RAW_PICTURE_PATH, -- 原始图片路径\n\tt.MARK_INFO,  -- 标记信息\n\tt.IS_PAST,  -- 是否以往重复缺陷\n\tt.REPEAT_ID, -- 重复缺陷ID\n\tt.SOLVE_COMPLETE_TIME, -- 销记时间\n\tt.DEFECT_TYPE_ID, -- 缺陷分类ID\n\tt.DEFECT_REASON_ID,  -- 缺陷成因ID\n\tt.DISCOVER_SOURCE_TYPE_ID, -- 缺陷来源ID\n\tjdg.SOURCE_TYPE_NAME, -- 缺陷来源名称\n\tt.DISCOVER_SOURCE_ID, -- 数据发现来源ID\n\tt.SOLVE_SOURCE_TYPE_ID,  -- 数据处理来源类型ID\n\tt.SOLVE_SOURCE_ID, -- 数据处理来源ID\n\tt.REMARK, -- 备注\n\tt.SYSTEM_SOURCE, -- 数据来自哪个系统\n\tt.PILLAR_DEPT_ID, -- 支柱号所属工区id\n\tt.DEFECT_POSITION_ID,  -- 缺陷部位 id\n\tt.SOLVE_WORKAREA_ID, -- 整改责任工区\n\tt.HANDLE_WORKAREA_ID, -- 处理工区\n\tt.RECTIF_TIME,  -- 整改期限数字\n\tt.RECTIF_TIME_UNIT, -- 整改期限单位\n\tt.DEVICE_CLASS_ID, -- 设备类别ID\n\tt.INPUT_AUDIT_STATUS, -- 录入审核状态\n\tt.RECTIF_AUDIT_STATUS, -- 销号审核状态\n\tt.CHECK_AUDIT_STATUS, -- 校核状态\n\tt.RECTIFICATION_SUGGESTIONS, -- 整改建议\n\tt.DEFERRED_STATUS, -- 延期状态\n\tt.DEFECT_STATUS, -- 缺陷状态\n\tt.PROCESS_SOURCE, -- 来源流程\n\tt.CREATE_DEPT_NO, -- 创建人部门code\n\tt.SOURCE_MODEL, -- 来源实体\n\tt.CREATE_DATETIME_SOURCE, -- 来源系统创建时间\n\tt.RETURN_STATUS, -- 回传状态\n\tt.OLD_ID, -- 旧缺陷id\n\tt.OLD_DEPTNAME, -- 旧缺陷部门名称\n\tt.OLD_SITENAME, -- 旧缺陷区站名称id\n\tt.PLAN_ID, -- 计划id\n\tt.JOB_ID, -- 作业id\n\tt.SHOW_NAME, -- 检测作业显示名字\n\tt.MEMO, -- 备注\n\tt.UNIT_DEPT_CODE, -- 段部门code\n\tt.RAIL_TYPE, -- 铁路类型\n\tt.DEFECT_VALUE, -- 缺陷值\n\tt.MAIN_ID,  -- 类型标识\n\t(SELECT NVL2(df.FILE_PATH, \'http://172.26.1.49:8083\' || df.FILE_PATH, \'\') FROM JCJC_DEFECT_FILE df WHERE df.DEFECT_INFO_ID = t.ID AND df.DEFECT_STAGE =1 AND ROWNUM = 1) AS DEFECT_FILE_FULL_PATH, -- 缺陷图片\n\t(SELECT NVL2(df.FILE_PATH, \'http://172.26.1.49:8083\' || df.FILE_PATH, \'\') FROM JCJC_DEFECT_FILE df WHERE df.DEFECT_INFO_ID = t.ID AND df.DEFECT_STAGE =3 AND ROWNUM = 1) AS SOLVE_FILE_FULL_PATH -- 消缺图片\nFROM\n\tJCJC_DEFECT_INFO t \n    LEFT JOIN JCW_DEFECT_SOURCE_TYPE jdg ON jdg.SOURCE_TYPE_ID = t.DISCOVER_SOURCE_TYPE_ID\n    WHERE (t.DEL_FLAG IS NULL OR t.DEL_FLAG =\'N\')\n;\n    \n\n\n===Additional Context \n\n\n\n### 深度功能描述  \n该视图用于整合铁路施工/检修计划的全量信息，支持多维度计划状态监控与跨部门协作管理。核心业务实体包括日计划（DAYPLANID）、部门（DEPT_ID）、线路（SECLINE_ID）、天窗计划（DSPID）及施工详情（WORK_CONTENT_INFLUENCE），通过多表关联实现数据聚合。典型场景包括生成周计划报表、追踪计划执行状态（如COMPLETE_FLAG、FLOW_NODE_STATUS）及跨部门协作信息同步。数据生命周期通过PLAN_DATE（计划日期）、START_TIME/END_TIME（时间范围）及状态字段（IS_CANCEL、FLOW_NODE_STATUS）体现，支持按周（weekFlag）或按状态筛选。  \n**SQL示例**：  \n1. `SELECT * FROM V_JCWB_DAYPLAN WHERE PLAN_DATE = \'2023-10-01\' AND COMPLETE_FLAG = 0;`（查询未开始的当日计划）  \n2. `SELECT DEPT_NAME, COUNT(*) FROM V_JCWB_DAYPLAN GROUP BY DEPT_NAME;`（统计各部门计划数量）  \n\n---\n\n### 表名: `V_JCWB_DAYPLAN`  \n**功能总结**: 该视图整合铁路日计划核心数据，涵盖计划基本信息、执行状态、线路信息、施工详情及跨部门协作字段，支持多维度查询与状态监控，适用于计划管理、执行跟踪及跨部门协同场景。  \n\n#### 字段结构  \n| 列名 | 类型 | 可空? | 默认值 | 键类型 | 描述 |  \n|------|------|-------|--------|--------|------|  \n| DAYPLANID | NUMBER | 否 | - | PK | 日计划主键ID |  \n| DSPID | NUMBER | 是 | - | FK | 天窗计划ID（关联JCWB_DAY_SKYLIGHT_PLAN） |  \n| PLAN_CODE | VARCHAR2 | 是 | - | - | 计划编号 |  \n| PLAN_DATE | DATE | 是 | - | - | 计划日期 |  \n| DEPT_ID | NUMBER | 是 | - | FK | 部门ID（关联SYS_DEPT） |  \n| DEPT_NAME | VARCHAR2 | 是 | - | - | 部门名称 |  \n| SECLINE_ID | VARCHAR2 | 是 | - | - | 线路ID（多线路逗号分隔） |  \n| SECLINE_NAME | VARCHAR2 | 是 | - | - | 线路名称（多线路逗号分隔） |  \n| RAIL_TYPE | VARCHAR2 | 是 | - | - | 线路类型（多线路类型逗号分隔） |  \n| PLAN_TYPE | NUMBER | 是 | - | - | 计划类型（1-检修，2-施工等） |  \n| PLAN_TYPE_NAME | VARCHAR2 | 是 | - | - | 计划类型名称 |  \n| START_TIME | DATE | 是 | - | - | 计划开始时间 |  \n| END_TIME | DATE | 是 | - | - | 计划结束时间 |  \n| WORK_MINUTES | NUMBER | 是 | - | - | 作业分钟数 |  \n| COMPLETE_FLAG | NUMBER | 是 | 0 | - | 完成状态（0-未开始，1-完成，2-进行中） |  \n| FLOW_NODE_STATUS | NUMBER | 是 | - | - | 流程节点状态（-1-全部完成，0-计划导入等） |  \n| REPLY_STATUS | NUMBER | 是 | - | - | 批复状态（0-未批复，1-已通过） |  \n| TRAIN_LIMIT | VARCHAR2 | 是 | - | - | 行车限制卡 |  \n| REGIST_STATION | VARCHAR2 | 是 | - | - | 登记站 |  \n| TRAIN_INFOR | VARCHAR2 | 是 | - | - | 路用列车信息 |  \n| SKYLIGHT_TYPE_NAME | VARCHAR2 | 是 | - | - | 天窗类型名称 |  \n| OVERHAUL_TYPE | NUMBER | 是 | - | - | 天窗计划类型（1-检修，2-施工等） |  \n| OVERHAUL_TYPE_NAME | VARCHAR2 | 是 | - | - | 天窗计划类型名称 |  \n| WORK_LEADER | VARCHAR2 | 是 | - | - | 负责人 |  \n| DIRECTION_NAME | VARCHAR2 | 是 | - | - | 行别名称 |  \n| IS_CANCEL | NUMBER | 是 | - | - | 是否取消 |  \n| REMARK | VARCHAR2 | 是 | - | - | 备注 |  \n| WEEKFLAG | VARCHAR2 | 是 | - | - | 计划日期所在周（ISO周格式） |  \n| WORK_PROJECT | VARCHAR2 | 是 | - | - | 施工项目 |  \n| WORK_ADDRESS | VARCHAR2 | 是 | - | - | 施工地点 |  \n| WORK_MILEAGE | VARCHAR2 | 是 | - | - | 施工里程 |  \n| BLOCK_MILEAGE | VARCHAR2 | 是 | - | - | 封锁里程 |  \n| WORK_CONTENT_INFLUENCE | VARCHAR2 | 是 | - | - | 施工内容及影响范围 |  \n| BUSINESS_OFFICES | VARCHAR2 | 是 | - | - | 审核流程 |  \n| WORK_DEPT_AND_LEADER | VARCHAR2 | 是 | - | - | 施工单位及负责人 |  \n| WORK_LEVEL | VARCHAR2 | 是 | - | - | 等级 |  \n| FLOW_TRACK | VARCHAR2 | 是 | - | - | 流程跟踪 |  \n| COORDINATE_DEPT | VARCHAR2 | 是 | - | - | 配合单位 |  \n| JOINTLY_SIGN | VARCHAR2 | 是 | - | - | 会签 |  \n| WORK_LEADER_TEL | VARCHAR2 | 是 | - | - | 负责人电话 |\n\n\n\n### 深度功能描述  \n该视图`V_JCJC_DEFECT_INFO`用于集中管理铁路设备缺陷的全生命周期信息，核心业务目的是实现缺陷的发现、处理、审核及状态跟踪。关键业务实体包括缺陷本身（通过`ID`标识）、线路（`LINE_ID`）、支柱（`PILLAR_ID`）、部门（`DEPT_ID`）、处理人员（`SOLVE_PERSONAL`）等，通过多表关联（如`JCW_DEFECT_SOURCE_TYPE`）形成完整缺陷管理链路。典型使用场景包括缺陷工单生成、处理进度监控、统计分析报表生成等。数据生命周期特征体现在`DETECT_DATE`（检测时间）、`FIND_DATE`（发现时间）、`SOLVE_DATE`（处理时间）等时间字段，以及`STATUS`（缺陷状态）和`SIX_STATUS`（6C系统状态）的流转。  \n**SQL示例**：  \n1. 查询某线路所有未处理缺陷：`SELECT * FROM V_JCJC_DEFECT_INFO WHERE LINE_ID = \'XXX\' AND STATUS = \'UNRESOLVED\'`  \n2. 获取某支柱的缺陷历史记录：`SELECT PILLAR_NUM, DEFECT_DESCRIPTION, SOLVE_DATE FROM V_JCJC_DEFECT_INFO WHERE PILLAR_ID = \'YYY\' ORDER BY FIND_DATE DESC`\n3. 查询2025年2月9日当天的缺陷数量: SELECT COUNT(*) FROM V_JCJC_DEFECT_INFO WHERE FIND_DATE = TO_DATE(\'2025-02-09\', \'YYYY-MM-DD\');\n\n---\n\n### 表名: `V_JCJC_DEFECT_INFO`  \n**功能总结**: 该视图整合铁路设备缺陷的多维度信息，涵盖缺陷描述、处理流程、责任部门及状态跟踪，支持缺陷管理全流程的查询与分析。  \n\n#### 字段结构  \n| 列名 | 类型 | 可空? | 默认值 | 键类型 | 描述 |  \n|------|------|-------|--------|--------|-