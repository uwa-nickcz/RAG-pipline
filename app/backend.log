    LINE_NAME, 
    TO_CHAR(TRUNC(FIND_DATE, 'MM'), 'YYYY-MM') AS month, 
    COUNT(*) AS defect_count
FROM 
    V_JCJC_DEFECT_INFO
WHERE 
    FIND_DATE >= TO_DATE('2025-01-01', 'YYYY-MM-DD') 
    AND FIND_DATE < TO_DATE('2026-01-01', 'YYYY-MM-DD')
GROUP BY 
    LINE_ID, 
    LINE_NAME, 
    TRUNC(FIND_DATE, 'MM')
ORDER BY 
    LINE_ID, 
    month;
